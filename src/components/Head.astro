---
import { INDEXABLE, SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title} — ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shouldNoindex = !INDEXABLE || noindex;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link
  rel="preload"
  href="/fonts/noto-sans-latin-variable.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary" />
{shouldNoindex && <meta name="robots" content="noindex, nofollow" />}
