---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, kind, role, period, stack, artefacts } = entry.data;
---

<Base {title} description={summary}>
  <article class="case-study">
    <header class="case-header">
      <p class="eyebrow">{kind}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <dl class="case-facts">
        <div><dt>Role</dt><dd>{role}</dd></div>
        <div><dt>Period</dt><dd>{period}</dd></div>
        {stack.length > 0 && <div><dt>Tools</dt><dd>{stack.join(' · ')}</dd></div>}
      </dl>
    </header>
    {
      artefacts.length > 0 && (
        <aside class="artefacts" aria-labelledby="artefacts-title">
          <h2 id="artefacts-title">Source material and artefacts</h2>
          <ul>
            {artefacts.map((artefact) => (
              <li><a href={artefact.href}>{artefact.label}</a></li>
            ))}
          </ul>
        </aside>
      )
    }
    <div class="prose case-body"><slot /></div>
  </article>
</Base>
