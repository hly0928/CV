---
import CV, { frontmatter } from '../../content/cv.md';
import type { CVFrontmatter } from '../../types';
import Base from '../../layouts/Base.astro';
import CVHeader from '../../components/CVHeader.astro';

export const prerender = true;

const cv = frontmatter as CVFrontmatter;
---

<Base title="CV" description="Curriculum vitae for Clementine Hu." wide>
  <article class="cv-page">
    <div class="cv-actions">
      <button class="button" type="button" data-print-cv>Print / Download PDF</button>
    </div>
    <CVHeader {cv} />
    <div class="cv-body prose">
      <CV />
    </div>
  </article>
</Base>

<script>
  document.querySelector<HTMLButtonElement>('[data-print-cv]')?.addEventListener('click', () => {
    window.print();
  });
</script>
