---
import CV, { frontmatter } from '../../content/cv.md';
import type { CVFrontmatter } from '../../types';
import Base from '../../layouts/Base.astro';
import CVHeader from '../../components/CVHeader.astro';

const cv = frontmatter as CVFrontmatter;
---

<Base title="CV" description="Curriculum vitae for Clementine Hu." wide>
  <article class="cv-page">
    <CVHeader {cv} />
    <div class="cv-body prose">
      <CV />
    </div>
  </article>
</Base>
