---
import Resume, { frontmatter } from '../../content/resume.md';
import type { ResumeFrontmatter } from '../../types';
import Base from '../../layouts/Base.astro';
import ResumeHeader from '../../components/ResumeHeader.astro';

const resume = frontmatter as ResumeFrontmatter;
---

<Base title="CV" description="Curriculum vitae for Clementine Hu." wide>
  <article class="resume-page">
    <ResumeHeader {resume} />
    <div class="resume-body prose">
      <Resume />
    </div>
  </article>
</Base>
