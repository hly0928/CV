---
import { getCollection } from 'astro:content';
import type { CVFrontmatter } from '../types';
import { frontmatter } from '../content/cv.md';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

export const prerender = true;

const cv = frontmatter as CVFrontmatter;
const work = (await getCollection('work', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} home>
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow">Perth, Western Australia</p>
    <h1 id="hero-title">{cv.name}</h1>
    <p class="hero__headline">{cv.headline}</p>
    <p class="hero__intro">
      I document how systems work, investigate practical problems, and turn troubleshooting into
      guidance others can follow. My background combines information technology with administrative
      management.
    </p>
    <nav class="hero__social" aria-label="Professional profiles and contact">
      <a href={cv.linkedin} aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5.2 7.7A2.2 2.2 0 1 0 5.2 3.3a2.2 2.2 0 0 0 0 4.4ZM3.3 20.7h3.8V9.3H3.3v11.4Zm6.2 0h3.8v-6.3c0-1.7.3-3.3 2.4-3.3 2 0 2 1.9 2 3.4v6.2h3.8v-7c0-3.4-.7-6.1-4.8-6.1-1.9 0-3.2 1.1-3.8 2.1h-.1V9.3H9.5v11.4Z" />
        </svg>
      </a>
      <a href={cv.github} aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2.7a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.9c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-4.7 0-1 .4-1.9 1-2.6-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.3 9.3 0 0 1 4.9 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.6 0 3.7-2.4 4.5-4.6 4.7.4.3.7.9.7 1.8v2.8c0 .3.2.6.7.5A9.5 9.5 0 0 0 12 2.7Z" clip-rule="evenodd" />
        </svg>
      </a>
      <a href={`mailto:${cv.email}`} aria-label={`Email ${cv.email}`} title="Email">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3.5 5.3h17c.8 0 1.5.7 1.5 1.5v10.4c0 .8-.7 1.5-1.5 1.5h-17c-.8 0-1.5-.7-1.5-1.5V6.8c0-.8.7-1.5 1.5-1.5Zm8.5 7.3 7.6-5.3H4.4l7.6 5.3Zm0 2.2L4 9.2v7.5h16V9.2l-8 5.6Z" />
        </svg>
      </a>
    </nav>
    <div class="hero__actions">
      <a class="text-link" href="/work/">View work</a>
      <a class="button" href="/cv/">Read CV <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="featured-work" aria-labelledby="featured-title">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <h2 id="featured-title">Case studies grounded in evidence</h2>
    </div>
    <div class="work-carousel" data-work-carousel>
      <div
        class="work-grid"
        role="region"
        aria-label="Selected case studies"
        tabindex="0"
        data-work-carousel-track
      >
        {work.map((entry) => <WorkCard {entry} />)}
      </div>
      <button
        class="work-carousel__hint"
        type="button"
        aria-label="Scroll selected work to the right"
        data-work-carousel-next
        hidden
      >→</button>
    </div>
  </section>
</Base>

<script>
  const carousels = document.querySelectorAll<HTMLElement>('[data-work-carousel]');

  for (const carousel of carousels) {
    const track = carousel.querySelector<HTMLElement>('[data-work-carousel-track]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-work-carousel-next]');

    if (!track || !next) continue;

  const updateNext = () => {
    const maxScroll = track.scrollWidth - track.clientWidth;
    const atStart = track.scrollLeft <= 2;
    const atEnd = maxScroll <= 1 || track.scrollLeft >= maxScroll - 2;

    next.hidden = atEnd;
    carousel.classList.add('is-enhanced');
    carousel.classList.toggle('is-at-start', atStart);
    carousel.classList.toggle('is-at-end', atEnd);
  };

    next.addEventListener('click', () => {
      track.scrollBy({ left: track.clientWidth, behavior: 'smooth' });
    });
    track.addEventListener('scroll', updateNext, { passive: true });
    new ResizeObserver(updateNext).observe(track);
    requestAnimationFrame(updateNext);
  }
</script>
